#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

NAME="ripperdoc"
PROG="/usr/bin/ripperdoc"

uci_get_by_type() {
	local ret
	ret=$(uci get ${NAME}.${1}.${2} 2>/dev/null)
	echo "${ret:=$3}"
}

start_service() {
	local enabled
	enabled=$(uci_get_by_type config enabled 0)
	[ "$enabled" -eq 1 ] || return 0

	local model safe_mode verbose mcp tools workdir log_file
	model=$(uci_get_by_type config model "claude-sonnet-4-20250514")
	custom_model=$(uci_get_by_type config custom_model "")
	safe_mode=$(uci_get_by_type config safe_mode 1)
	verbose=$(uci_get_by_type config verbose 0)
	mcp=$(uci_get_by_type config mcp 1)
	tools=$(uci_get_by_type config tools "")
	workdir=$(uci_get_by_type config workdir "/root")
	log_file=$(uci_get_by_type config log_file "/var/log/ripperdoc.log")

	# Use custom model name if set
	if [ -n "$custom_model" ]; then
		model="$custom_model"
	fi

	# Export API keys
	local anthropic_api_key openai_api_key deepseek_api_key kimi_api_key qwen_api_key glm_api_key
	anthropic_api_key=$(uci_get_by_type api_keys anthropic_api_key "")
	openai_api_key=$(uci_get_by_type api_keys openai_api_key "")
	deepseek_api_key=$(uci_get_by_type api_keys deepseek_api_key "")
	kimi_api_key=$(uci_get_by_type api_keys kimi_api_key "")
	qwen_api_key=$(uci_get_by_type api_keys qwen_api_key "")
	glm_api_key=$(uci_get_by_type api_keys glm_api_key "")

	# Build environment file
	local env_file="/var/run/${NAME}.env"
	cat > "$env_file" <<-EOF
	EOF

	[ -n "$anthropic_api_key" ] && echo "ANTHROPIC_API_KEY=$anthropic_api_key" >> "$env_file"
	[ -n "$openai_api_key" ] && echo "OPENAI_API_KEY=$openai_api_key" >> "$env_file"
	[ -n "$deepseek_api_key" ] && echo "DEEPSEEK_API_KEY=$deepseek_api_key" >> "$env_file"
	[ -n "$kimi_api_key" ] && echo "KIMI_API_KEY=$kimi_api_key" >> "$env_file"
	[ -n "$qwen_api_key" ] && echo "QWEN_API_KEY=$qwen_api_key" >> "$env_file"
	[ -n "$glm_api_key" ] && echo "GLM_API_KEY=$glm_api_key" >> "$env_file"

	chmod 600 "$env_file"

	# Build command arguments
	local args=""
	args="$args --model $model"

	[ "$safe_mode" -eq 0 ] && args="$args --yolo"
	[ "$verbose" -eq 1 ] && args="$args --verbose"
	[ "$mcp" -eq 0 ] && args="$args --no-mcp"
	[ -n "$tools" ] && args="$args --tools $tools"

	procd_open_instance "$NAME"
	procd_set_param command "$PROG" $args
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/ripperdoc
	procd_set_param env $(cat "$env_file" 2>/dev/null | tr '\n' ' ')
	procd_set_param pidfile /var/run/${NAME}.pid
	[ -n "$workdir" ] && procd_set_param cwd "$workdir"
	procd_close_instance
}

stop_service() {
	rm -f /var/run/${NAME}.env
}

service_triggers() {
	procd_add_reload_trigger "ripperdoc"
}

reload_service() {
	stop
	start
}
