#!/usr/bin/env python3
"""Ripperdoc Web API - CGI endpoint for the LuCI chat interface."""
import json
import os
import sys
import time
import uuid
import subprocess

SESSIONS_DIR = "/var/lib/ripperdoc/sessions"
WORKER = "/usr/lib/ripperdoc/worker.py"
CONFIG_FILE = os.path.expanduser("~/.ripperdoc.json")


def read_body():
    try:
        n = int(os.environ.get("CONTENT_LENGTH", 0))
        return json.loads(sys.stdin.read(n)) if n > 0 else {}
    except Exception:
        return {}


def respond(data):
    sys.stdout.write("Content-Type: application/json\r\n\r\n")
    sys.stdout.write(json.dumps(data))
    sys.stdout.flush()


def session_path(sid):
    return os.path.join(SESSIONS_DIR, sid + ".json")


def load(sid):
    with open(session_path(sid)) as f:
        return json.load(f)


def save(session):
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    with open(session_path(session["id"]), "w") as f:
        json.dump(session, f)


def list_sessions():
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    result = []
    for name in os.listdir(SESSIONS_DIR):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(SESSIONS_DIR, name)) as f:
                d = json.load(f)
            result.append({
                "id": d["id"],
                "title": d.get("title", "New Session"),
                "created": d.get("created", 0),
                "message_count": len(d.get("messages", [])),
            })
        except Exception:
            pass
    result.sort(key=lambda x: x["created"], reverse=True)
    return result


def new_session():
    s = {
        "id": uuid.uuid4().hex[:8],
        "title": "New Session",
        "created": time.time(),
        "messages": [],
        "working": False,
    }
    save(s)
    return s


def get_session(data):
    return load(data["session_id"])


def send_message(data):
    sid = data["session_id"]
    content = data["content"]
    s = load(sid)
    s["messages"].append({"role": "user", "content": content, "timestamp": time.time()})
    if len(s["messages"]) == 1:
        s["title"] = content[:50]
    s["working"] = True
    save(s)
    subprocess.Popen(
        [sys.executable, WORKER, sid],
        stdout=open("/dev/null", "w"),
        stderr=open("/dev/null", "w"),
        start_new_session=True,
    )
    return s


def delete_session(data):
    p = session_path(data["session_id"])
    if os.path.exists(p):
        os.remove(p)
    return {"ok": True}


def get_config(_=None):
    if os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE) as f:
            return json.load(f)
    return {}


def save_config(data):
    cfg = data.get("config", {})
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
    return {"ok": True}


ACTIONS = {
    "list_sessions": lambda _: list_sessions(),
    "new_session": lambda _: new_session(),
    "get_session": get_session,
    "send_message": send_message,
    "delete_session": delete_session,
    "get_config": lambda _: get_config(),
    "save_config": save_config,
}

try:
    body = read_body()
    action = body.get("action", "")
    handler = ACTIONS.get(action)
    if handler:
        respond(handler(body))
    else:
        respond({"error": "unknown action: " + action})
except Exception as e:
    respond({"error": str(e)})
